# Diese Datei nach .env.local kopieren und die lokalen Laragon-Zugangsdaten einsetzen.
# .env.local ist durch .gitignore geschützt und darf nie eingecheckt werden.
DATABASE_URL="mysql://DATABASE_USER:DATABASE_PASSWORD@127.0.0.1:3306/aesculapp?serverVersion=8.4.3&charset=utf8mb4"

# Branding and tenant selection for a dedicated pharmacy app deployment.
APP_TENANT_SLUG=stadtapotheke-trofaiach
APP_CLIENT_URL=http://localhost:4200
APP_MAIL_FROM=no-reply@stadtapotheke-trofaiach.test

# Local default: no email is sent. Replace with a real SMTP DSN to test the reset email.
MAILER_DSN=null://null
