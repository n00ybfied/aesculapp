# Copy this file to server/.env.local on the demo server and replace every placeholder.
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=GENERATE_A_RANDOM_64_CHARACTER_HEX_VALUE
DATABASE_URL="mysql://aesculapp_demo:URL_ENCODED_DATABASE_PASSWORD@127.0.0.1:3306/aesculapp_demo?serverVersion=8.4.6&charset=utf8mb4"

DEFAULT_URI=https://api.aesculapp.floatbox.at
CORS_ALLOW_ORIGIN='^https://aesculapp\.floatbox\.at$'

APP_TENANT_SLUG=stadtapotheke-trofaiach
APP_CLIENT_URL=https://aesculapp.floatbox.at
APP_MAIL_FROM=no-reply@stadtapotheke-trofaiach.at
MAILER_DSN=null://null

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=GENERATE_A_SEPARATE_RANDOM_VALUE
